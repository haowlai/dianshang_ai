# ==============================================================================
# AgenticCommerce 生产环境变量配置文件模版 (.env.prod)
# 生产部署前，请复制此文件为 .env.prod，并修改其中的密码与密钥！
# ==============================================================================

# 基础运行环境
ENVIRONMENT=production
DEBUG=false
APP_NAME=AgenticCommerce
APP_VERSION=v1.0.0

# PostgreSQL 生产配置 (强烈建议使用强密码)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_2026
POSTGRES_DB=dianshang_ai
DATABASE_URL=postgresql+asyncpg://postgres:your_strong_postgres_password_2026@postgres:5432/dianshang_ai

# Redis 生产配置
REDIS_URL=redis://:your_strong_redis_password@redis:6379/0
REDIS_PASSWORD=your_strong_redis_password

# MinIO 对象存储生产配置
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=agentic_admin_2026
MINIO_SECRET_KEY=agentic_secure_secret_key_2026
MINIO_BUCKET_NAME=agentic-assets
MINIO_SECURE=false

# 阿里云百炼大模型 DashScope API Key (必填)
# 前往申请：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-aliyun-dashscope-api-key-here

# JWT 身份鉴权密钥 (请在终端执行 openssl rand -hex 32 生成并填入)
JWT_SECRET_KEY=9a3b8c7e6d5f4a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 生产允许跨域来源域名 (英文逗号分隔)
BACKEND_CORS_ORIGINS=https://ai.yourdomain.com,http://localhost:5173
