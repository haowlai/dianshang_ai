# ==============================================================================
# AgenticCommerce (自主智能体电商平台) 环境变量配置模板
# 复制本文件为 .env 并填入实际值: cp conf/.env.example .env
# 隔离端口说明：PostgreSQL 5434, Redis 6381, MinIO 9010/9011 (防止与主机现有容器冲突)
# ==============================================================================

# 基础服务与运行环境
APP_ENV=dev
APP_NAME=AgenticCommerce
APP_HOST=0.0.0.0
APP_PORT=8002
DEBUG=true

# 安全与认证 (JWT)
AUTH_ENABLED=true
SECRET_KEY=agentic-commerce-dev-secret-key-change-it-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 跨域与主机白名单
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","agentic-backend"]

# PostgreSQL 16 + pgvector (防冲突隔离端口 5434)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_commerce
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis 7 (防冲突隔离端口 6381)
REDIS_PORT=6381
REDIS_URL=redis://127.0.0.1:6381/0

# MinIO 对象存储 (防冲突隔离端口 9010/9011)
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ENDPOINT=127.0.0.1:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentic-assets
MINIO_SECURE=false

# 业务生成配置
ALLOW_MOCK_ASSETS=true           # 开发阶段未配 Key 时自动优雅降级为 Mock
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
MAX_QUALITY_RETRIES=2

# AI 模型厂商 API Key (支持真实接入，留空则自动降级为高保真 Mock)
DASHSCOPE_API_KEY=
WANX_API_KEY=
KLING_API_KEY=
KLING_ACCESS_KEY_ID=
KLING_ACCESS_KEY_SECRET=
OPENAI_API_KEY=
SENSENOVA_API_KEY=
