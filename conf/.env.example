# ==============================================================================
# AgenticCommerce (自主智能体电商平台) 环境变量配置模板
# 复制本文件为 .env 并填入实际值: cp conf/.env.example .env
# ==============================================================================

# 基础服务与运行环境
APP_ENV=dev
APP_NAME=AgenticCommerce
APP_HOST=0.0.0.0
APP_PORT=8002
DEBUG=true

# 安全与认证 (JWT)
AUTH_ENABLED=true
SECRET_KEY=agentic-commerce-dev-secret-key-change-it-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 跨域与主机白名单
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","agentic-backend"]

# PostgreSQL 16 + pgvector
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_commerce
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis 7 (缓存 / 任务队列 / 信号量)
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO 对象存储
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentic-assets
MINIO_SECURE=false

# 业务生成配置
ALLOW_MOCK_ASSETS=true
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
MAX_QUALITY_RETRIES=2

# AI 模型厂商 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
WANX_API_KEY=your_wanx_api_key_here
KLING_API_KEY=your_kling_api_key_here
KLING_ACCESS_KEY_ID=your_kling_ak_here
KLING_ACCESS_KEY_SECRET=your_kling_sk_here
OPENAI_API_KEY=your_openai_api_key_here
SENSENOVA_API_KEY=your_sensenova_api_key_here
